# ==============================================================
# BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE) - HẠ TẦNG MẠNG DTHU WLAN
# Lưu ý: Sao chép file này thành .env và điền mật khẩu thực tế
# ==============================================================

# Cấu hình Bộ điều khiển WLC
WLC_PRIMARY_IP=172.16.50.10
WLC_STANDBY_IP=172.16.50.11
WLC_MGMT_VLAN=50
WLC_ADMIN_USER=admin_dthu
WLC_ADMIN_PASSWORD=change_this_wlc_password

# Cấu hình Máy chủ Xác thực FreeRADIUS (802.1X AAA)
RADIUS_SERVER_IP=172.16.50.20
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_SECRET_KEY=Dthu@RadiusSecret2026!
LDAP_SERVER_URI=ldap://172.16.50.25
LDAP_BIND_DN="cn=admin,dc=dthu,dc=edu,dc=vn"
LDAP_BIND_PASSWORD=change_this_ldap_password

# Cấu hình Dải mạng Sinh viên & DHCP
STUDENT_VLAN_ID=20
STUDENT_SUBNET=172.16.20.0/20
STUDENT_DHCP_LEASE_TIME_HOURS=2

# Thông số Kiểm thử Thực nghiệm
SPEEDTEST_SERVER_ID=auto
TESTBENCH_LOG_LEVEL=INFO
